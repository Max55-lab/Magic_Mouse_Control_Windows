; Copyright (c) Magic Mouse Control contributors.
; License: MIT
;
; Draft INF for the Phase 3 `mmk-vhid` virtual precision touchpad function
; driver (root-enumerated). NOT build-verified: run `inf2cat` + `infverif` in
; the eWDK shell before touching a device.

[Version]
Signature       = "$WINDOWS NT$"
Class           = HIDClass
ClassGuid       = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider        = %Provider%
CatalogFile     = mmk-vhid.cat
PnpLockdown     = 1
DriverVer        = 11/15/2026,0.1.0.0

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
mmk-vhid.sys = 1

[Manufacturer]
%Mfg% = MMKVhid, NT$ARCH$

[MMKVhid.NT$ARCH$]
%DeviceDesc% = MMKVhid_Inst, ROOT\MMKVHID

[MMKVhid_Inst.NT]
CopyFiles = @mmk-vhid.sys

[MMKVhid_Inst.NT.HW]
AddReg = MMKVhid_HW

[MMKVhid_HW]
HKR,,"LowerFilters",0x00010000,"vhf"

[MMKVhid_Inst.NT.Services]
AddService = MMKVhid, 0x00000002, MMKVhid_Service

[MMKVhid_Service]
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\mmk-vhid.sys

[MMKVhid_Inst.NT.Wdf]
KmdfService = MMKVhid, MMKVhid_Wdf

[MMKVhid_Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
Provider   = "Magic Mouse Control"
Mfg        = "Magic Mouse Control"
DeviceDesc = "Magic Mouse Control virtual precision touchpad"
DiskName   = "Magic Mouse Control VHF driver"
